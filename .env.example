# Copy to .env (git-ignored). mise loads it automatically inside this directory.
# Create scoped keys in the RunPod console; never commit or paste real keys anywhere.

# Creates, patches and deletes serverless endpoints and tags (serverless: write).
RUNPOD_MANAGEMENT_KEY=

# Sends inference requests. Use a narrower key than the management one.
# Falls back to RUNPOD_MANAGEMENT_KEY when empty.
RUNPOD_INFERENCE_KEY=

# Optional default for `probe up -pool` (see `mise run probe -- catalog`).
SPIKE_GPU_POOL=
